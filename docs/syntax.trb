#import ("cuda")
#import ("core")
#import ("stdio")
#import ("math)

object Matrix {
    int dim,
    int[] values, 
}


extends Matrix private softmax_norm :: void () {

}


private matmul ::  (cuda.Matrix A,  B) 

main :: void () {
    // "new" keyword auto mallocs, but does not auto free.
    cuda.Matrix A = new cuda.Matrix(cuda.f16, 4,4);
    cuda.Matrix B = new cuda.Matrix(cuda.f16, 4,4);


    // Will return auto-malloc'd result
    cuda.Matrix C = cuda.matmul(A,B);

    // Every object has the ".ptr" method 
    core.memory.free(A.ptr);
    core.memory.free(B.ptr);

    stdio.out.println(C);

    core.memory.free(C.ptr);


    exit(0);


}


